{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/check.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/withdraw",
      "dest": "main.py"
    },
    {
      "src": "/api/check",
      "dest": "api/check.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
